# Copy this file to .env and fill in the Token Plan subscription key locally.
# Never paste the key into chat or commit the .env file.
MINIMAX_API_KEY=

# Optional separate pay-as-you-go key with Hailuo video Credits.
# The single-shot video probe requires this key and never falls back to the
# text/image Token Plan key.
MINIMAX_VIDEO_API_KEY=

# China-region MiniMax endpoints used by the feasibility probe.
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_ACCOUNT_BASE=https://www.minimaxi.com
